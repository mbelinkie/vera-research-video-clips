NODE_ENV=development
# For the isolated private one-command browser workflow, run
# `npm run dev:research` and opt into providers in your shell (README).
# It creates private credentials, enables the continuous worker, and overrides
# normal development storage/mode defaults below; do not source this entire
# generic example unchanged into the managed launcher.
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=43110
CLOUD_API_HOST=127.0.0.1
CLOUD_API_PORT=43111
# Production requires an HTTPS origin, Cognito, PostgreSQL with verified TLS,
# private S3, SQS, and server-side Translate. Values are injected from the
# deployed environment; never commit concrete production identifiers/secrets.
# PUBLIC_API_ORIGIN=https://api.example.com
CLOUD_DATABASE_MODE=pglite
DATABASE_SSL_MODE=disable
# Production verify-full mode requires the mounted Amazon RDS CA bundle.
# DATABASE_CA_CERT_PATH=/opt/research-video/certs/global-bundle.pem
# DATABASE_URL=postgresql://runtime-user@private-rds-host/research_video_clips
# Alternatively inject DATABASE_HOST, DATABASE_PORT, DATABASE_NAME,
# DATABASE_USERNAME, and DATABASE_PASSWORD as separate task fields/secrets.
CLOUD_AUTH_MODE=development
# Optional backend-only official YouTube Data API v3 key. Without it, YouTube
# URL ingest still works but the Search tab reports YouTube search unavailable.
# YOUTUBE_API_KEY=server-side-api-key
# COGNITO_USER_POOL_ID=us-east-1_example
# COGNITO_CLIENT_ID=public-native-client-id
# COGNITO_DOMAIN=https://auth.example.com
# COGNITO_REDIRECT_URI=research-video-clips://oauth/callback
# COGNITO_LOGOUT_URI=research-video-clips://oauth/logout
WEB_PORT=43112
DATA_DIR=./data
# Logged-clip exports: output defaults to DATA_DIR/exports, never caller-supplied.
# CLIP_EXPORT_DIR=/absolute/private/path/to/exports
# Full video cutting is a separate opt-in (independent of MEDIA_PROVIDER audio).
EXPORT_SOURCE_PROVIDER=disabled
# yt-dlp, FFmpeg and FFprobe must be installed and authorized for local use.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# CLI only: RESEARCH_AUTHORIZATION is a private project-member bearer;
# supply via shell environment, not argv or committed .env.example values.
# Mac pilot: explicit opt-in, local-only. Not safe for friend access until
# #51 auth and #53 secure tunnel/service deployment have been accepted.
# VERA_RUNTIME_MODE=mac-pilot
# DATABASE_MODE=postgres
# OBJECT_STORE_MODE=local
# PILOT_PG_URL=postgresql://least_privileged_user:<private-password>@127.0.0.1:5432/vera_research
# PILOT_OBJECT_ROOT=/absolute/private/encrypted/vera-transcripts
# LOCAL_UPLOAD_SIGNING_SECRET=<random-private-string-at-least-32-bytes>
# Development bearer credential for a registered worker user. Keep secrets out
# of source control and use the OS credential store in packaged builds.
# WORKER_AUTHORIZATION=Bearer <user-uuid>|<external-subject>
# One-shot is safest for development. A service/container can use continuous.
WORKER_MODE=once
WORKER_EXECUTION_LOCATION=local
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
WORKER_ERROR_BACKOFF_MS=5000
WORKER_LEASE_SECONDS=120
OBJECT_STORE_MODE=memory
QUEUE_MODE=memory
# JOB_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account-id/job-queue
# Optional local caption adapter. Leave disabled until yt-dlp is installed and
# its use is authorized for the selected source.
CAPTION_PROVIDER=disabled
# Managed Research caption-only opt-in: export CAPTION_PROVIDER=yt-dlp;
# YT_DLP_PATH=/absolute/path/to/yt-dlp; then npm run dev:research.
# Uncaptioned sources additionally need MEDIA_PROVIDER=yt-dlp-audio and
# SPEECH_TO_TEXT_PROVIDER=whisper-cpp with a real local executable/model.
YT_DLP_PATH=yt-dlp
# Authorized source audio acquisition is separately opt-in. The worker must
# delete acquired job scratch media after publication, failure, or cancellation.
MEDIA_PROVIDER=disabled
# Authorized full-source acquisition for explicit local clip exports. The
# one-shot command additionally requires --authorization-confirmed per run.
EXPORT_SOURCE_PROVIDER=disabled
# The dormant live smoke additionally requires EXPORT_SOURCE_PROVIDER=yt-dlp,
# both explicit command flags, and an absolute rights-cleared descriptor outside
# the repository. Normal tests and development never invoke it automatically.
# Local multilingual speech recognition is separately opt-in.
SPEECH_TO_TEXT_PROVIDER=disabled
WHISPER_CPP_PATH=whisper-cli
# WHISPER_CPP_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo.bin
# WHISPER_CPP_MODEL_NAME=large-v3-turbo
# Remote translation is opt-in. When enabled, the authenticated cloud API sends
# explicitly consented transcript segment text to Amazon Translate using its ECS
# task role. The local worker and desktop receive no AWS credentials.
TRANSLATION_PROVIDER=disabled
# AWS_TRANSLATE_TERMINOLOGY=research-project-terms
# AWS_PROFILE=research-video-dev
AWS_REGION=us-east-1
# Required when OBJECT_STORE_MODE=s3
# TRANSCRIPT_BUCKET=your-private-versioned-transcript-bucket

# The existing development bearer route is ONLY for loopback demos.
# NODE_ENV=production refuses any auth mode other than browser.
CLOUD_AUTH_MODE=development
# Browser BFF requires a separately approved, exact HTTPS origin and a trusted
# local TLS reverse proxy. Do not put Cognito secrets in VITE_* variables.
# CLOUD_AUTH_MODE=browser
# BROWSER_PUBLIC_ORIGIN=https://approved.example
# BROWSER_CALLBACK_URL=https://approved.example/cloud-api/auth/callback
# BROWSER_LOGOUT_URL=https://approved.example/
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YourPool
# COGNITO_DOMAIN=https://your-managed-login.auth.us-east-1.amazoncognito.com
# COGNITO_CLIENT_ID=server-only-web-client-id
# COGNITO_CLIENT_SECRET=server-only-web-client-secret
# TRUSTED_PROXY_PEERS=127.0.0.1,::1
# BROWSER_SESSION_IDLE_MS=1800000
# BROWSER_SESSION_ABSOLUTE_MS=28800000

# --- #53 friends-only Mac pilot hosting -------------------------------------
# These live in the PRIVATE pilot env file (chmod 600), default
# ~/Library/Application Support/VERA Research Pilot/pilot.env, never in .env.
# See docs/operations/mac-pilot-hosting.md.
# CLOUD_API_PORT=43211               # dedicated pilot port; never the dev default 43111
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=<64-hex Access application audience tag>
# OPERATOR_PORT=43114                 # loopback-only status port; never tunnelled
# PILOT_DISK_PAUSE_BELOW_MB=2048      # pause saving below this much free disk
# PILOT_HOME=/absolute/private/pilot/home     # defaults to the env file's folder
# PILOT_PG_BIN=/Applications/Postgres.app/Contents/Versions/18/bin
# PILOT_BACKUP_DESTINATION=/Users/<you>/Library/Mobile Documents/com~apple~CloudDocs/VERA Research Backups
# PILOT_BACKUP_KEY_FILE=/absolute/private/pilot/home/backup.key   # never inside the destination
# PILOT_DRILL_PG_URL=postgresql://vera_drill:<secret>@127.0.0.1:5432/postgres  # CREATEDB, not superuser
# PILOT_BACKUP_HOUR=3                 # daily backup time (local hour)
# PILOT_DRILL_WEEKDAY=0               # weekly restore drill (0 = Sunday)
# PILOT_TUNNEL_ID=<cloudflare tunnel uuid>
# PILOT_TUNNEL_CREDENTIALS=/Users/<you>/.cloudflared/<tunnel uuid>.json
# PILOT_TUNNEL_METRICS_PORT=43113
