NODE_ENV=development
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=43110
CLOUD_API_HOST=127.0.0.1
CLOUD_API_PORT=43111
# Production requires an HTTPS origin, Cognito, PostgreSQL with verified TLS,
# private S3, SQS, and server-side Translate. Values are injected from the
# deployed environment; never commit concrete production identifiers/secrets.
# PUBLIC_API_ORIGIN=https://api.example.com
CLOUD_DATABASE_MODE=pglite
DATABASE_SSL_MODE=disable
# Production verify-full mode requires the mounted Amazon RDS CA bundle.
# DATABASE_CA_CERT_PATH=/opt/research-video/certs/global-bundle.pem
# DATABASE_URL=postgresql://runtime-user@private-rds-host/research_video_clips
# Alternatively inject DATABASE_HOST, DATABASE_PORT, DATABASE_NAME,
# DATABASE_USERNAME, and DATABASE_PASSWORD as separate task fields/secrets.
CLOUD_AUTH_MODE=development
# COGNITO_USER_POOL_ID=us-east-1_example
# COGNITO_CLIENT_ID=public-native-client-id
# COGNITO_DOMAIN=https://auth.example.com
# COGNITO_REDIRECT_URI=research-video-clips://oauth/callback
# COGNITO_LOGOUT_URI=research-video-clips://oauth/logout
WEB_PORT=43112
DATA_DIR=./data
# Development bearer credential for a registered worker user. Keep secrets out
# of source control and use the OS credential store in packaged builds.
# WORKER_AUTHORIZATION=Bearer <user-uuid>|<external-subject>
# One-shot is safest for development. A service/container can use continuous.
WORKER_MODE=once
WORKER_EXECUTION_LOCATION=local
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
WORKER_ERROR_BACKOFF_MS=5000
WORKER_LEASE_SECONDS=120
OBJECT_STORE_MODE=memory
QUEUE_MODE=memory
# JOB_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account-id/job-queue
# Optional local caption adapter. Leave disabled until yt-dlp is installed and
# its use is authorized for the selected source.
CAPTION_PROVIDER=disabled
YT_DLP_PATH=yt-dlp
# Authorized source audio acquisition is separately opt-in. The worker must
# delete acquired job scratch media after publication, failure, or cancellation.
MEDIA_PROVIDER=disabled
# Authorized full-source acquisition for explicit local clip exports. The
# one-shot command additionally requires --authorization-confirmed per run.
EXPORT_SOURCE_PROVIDER=disabled
# The dormant live smoke additionally requires EXPORT_SOURCE_PROVIDER=yt-dlp,
# both explicit command flags, and an absolute rights-cleared descriptor outside
# the repository. Normal tests and development never invoke it automatically.
# Local multilingual speech recognition is separately opt-in.
SPEECH_TO_TEXT_PROVIDER=disabled
WHISPER_CPP_PATH=whisper-cli
# WHISPER_CPP_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo.bin
# WHISPER_CPP_MODEL_NAME=large-v3-turbo
# Remote translation is opt-in. When enabled, the authenticated cloud API sends
# explicitly consented transcript segment text to Amazon Translate using its ECS
# task role. The local worker and desktop receive no AWS credentials.
TRANSLATION_PROVIDER=disabled
# AWS_TRANSLATE_TERMINOLOGY=research-project-terms
# AWS_PROFILE=research-video-dev
AWS_REGION=us-east-1
# Required when OBJECT_STORE_MODE=s3
# TRANSCRIPT_BUCKET=your-private-versioned-transcript-bucket
