{
  "name": "research-video-clip-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "aws:deploy": "bash scripts/deploy-aws.sh",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build:web && npm run db:migrate:local:test && npm run db:migrate:cloud:test",
    "db:migrate:cloud:test": "node --import tsx packages/db-cloud/src/cli.ts --test",
    "db:migrate:local": "node --import tsx packages/db-local/src/cli.ts",
    "db:migrate:local:test": "node --import tsx packages/db-local/src/cli.ts --test",
    "dev": "concurrently -n web,local,cloud,worker -c blue,green,magenta,yellow \"npm:dev:web\" \"npm:dev:local-agent\" \"npm:dev:cloud-api\" \"npm:dev:worker\"",
    "dev:cloud-api": "node --import tsx apps/cloud-api/src/main.ts",
    "dev:local-agent": "node --import tsx apps/local-agent/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "node --import tsx apps/worker/src/main.ts",
    "export:run-once": "node --import tsx apps/local-agent/src/export-run-once.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture:media": "node --import tsx scripts/generate-media-fixture.ts",
    "test": "vitest run --exclude tests/e2e/**",
    "test:aws:s3": "vitest run tests/integration/shared-transcript-store.aws.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@electric-sql/pglite": "^0.5.4",
    "fastify": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
